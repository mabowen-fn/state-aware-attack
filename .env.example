# Target model: Ollama OpenAI-compatible endpoint
TARGET_BASE_URL=http://localhost:11434/v1
TARGET_API_KEY=placeholder
TARGET_MODEL=llama3.1:8b
TARGET_TEMPERATURE=0.0
TARGET_MAX_TOKENS=512
TARGET_TIMEOUT_SECONDS=180
