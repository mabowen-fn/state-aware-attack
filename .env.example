# Official HarmBench judge endpoint for canonical ASR
JUDGE_SCORE_URL=http://localhost:18080/score
# Optional extended endpoint. Use only for exploratory logit analysis.
JUDGE_SCORE_FULL_URL=http://localhost:18082/score_full
# /health is POST according to the supplied service contract.
JUDGE_HEALTH_URL=http://localhost:18082/health
JUDGE_TIMEOUT_SECONDS=90

# Optional future auxiliary model metadata. The week-1 fixed-script runner does not call it.
AUX_BASE_URL=http://localhost:11434/v1
AUX_API_KEY=placeholder
AUX_MODEL=mgraffam/qwen3.8-EfficientThink-uncensored:27b
